<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FF7854">

        <ImageButton
            android:id="@+id/btnQuayLai"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_icon_arrowleft"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Quản lý danh mục"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#263746" />
    </LinearLayout>

    <EditText
        android:id="@+id/edtTimDanhMuc"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:padding="12dp"
        android:hint="Tìm kiếm danh mục..."
        android:singleLine="true"
        android:inputType="text"
        android:backgroundTint="#FF7854" />

    <Button
        android:id="@+id/btnThemDanhMuc"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="＋ Thêm danh mục"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF7854" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDanhMuc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>
