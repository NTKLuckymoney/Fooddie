<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_logo_danhmuc"
            android:scaleType="centerInside"
            android:contentDescription="Danh mục" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTenDanhMuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Món nước"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSoLuongMon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="5 món ăn"
                android:textColor="#888888"
                android:textSize="13sp" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/btnSuaDanhMuc"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_icon_pen"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FF7854"
            android:contentDescription="Sửa danh mục" />
        <ImageButton
            android:id="@+id/btnXoaDanhMuc"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_icon_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa danh mục" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
