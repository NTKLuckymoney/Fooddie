<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F7F7F7"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:background="#FF7854"
            android:paddingEnd="16dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:src="@drawable/ic_logo_chef" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Fooddie"
                android:textColor="#263746"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDangXuat"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="Đăng xuất"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_icon_logout"
                app:tint="#263746" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutDanhMuc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMonAn"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgMonAn"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_logo_food"
                        android:background="#FFF0E9"
                        android:padding="16dp"
                        android:contentDescription="Ảnh món ăn" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:text="Quản lý món ăn"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#263746" />
                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_icon_arrowright"
                        app:tint="#FF7854"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/cardDanhMuc"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgDanhMuc"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:contentDescription="Ảnh danh mục"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_logo_danhmuc"
                        android:background="#FFF0E9"
                        android:padding="16dp"/>

                    <TextView
                        android:layout_width="255dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="20dp"
                        android:layout_weight="1"
                        android:text="Quản lý danh mục"
                        android:textColor="#263746"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_icon_arrowright"
                        app:tint="#FF7854"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/cardHoaDon"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgHoaDon"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Ảnh hóa đơn"
                        android:src="@drawable/ic_logo_hoadon"
                        android:background="#FFF0E9"
                        android:padding="16dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:text="Quản lý hóa đơn"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#263746" />
                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_icon_arrowright"
                        app:tint="#FF7854"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/cardThongKe"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgThongKe"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="#FFF0E9"
                        android:contentDescription="Ảnh thống kê"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_logo_doanhthu" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:text="Thống kê doanh thu"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#263746" />
                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_icon_arrowright"
                        app:tint="#FF7854"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
