<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">
    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FF7854">

        <ImageButton
            android:id="@+id/btnQuayLai"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_icon_arrowleft"
            app:tint="#263746"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Quản lý hóa đơn"
            android:textColor="#263746"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Khu vực tìm kiếm và thêm hóa đơn -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnSearchHoaDon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:backgroundTint="@color/white"
            android:src="@drawable/ic_icon_search"
            app:tint="#FF7854"/>
        <EditText
            android:id="@+id/edtTimHoaDon"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#FF7854"
            android:hint="Tìm kiếm theo mã hóa đơn..."
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textSize="15sp" />

    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:text="Danh sách hóa đơn"
        android:textColor="#333333"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Danh sách hóa đơn -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHoaDon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btnThemHoaDon"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_gravity="end"
        android:text="+ Thêm hóa đơn"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF7854" />

</LinearLayout>
