<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTenMon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phở bò"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnXoaMon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#E55353"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bỏ món khỏi hóa đơn" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtDonGia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="45.000đ"
                android:textColor="#777777"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGiam"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:text="−"
                android:textSize="18sp"
                android:backgroundTint="#FFF0E9"
                android:textColor="#FF7854" />

            <TextView
                android:id="@+id/txtSoLuong"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="#333333"
                android:textSize="16sp" />
            <Button
                android:id="@+id/btnTang"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:text="+"
                android:textSize="18sp"
                android:backgroundTint="#FFF0E9"
                android:textColor="#FF7854" />
        </LinearLayout>
        <TextView
            android:id="@+id/txtThanhTien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:text="45.000đ"
            android:textColor="#FF7854"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
