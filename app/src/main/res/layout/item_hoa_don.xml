<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtMaHoaDon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HD001"
                android:textColor="#333333"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTongTien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="130.000đ"
                android:textColor="#FF7854"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ngày lập -->
        <TextView
            android:id="@+id/txtNgayLap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ngày lập: 14/11/2026"
            android:textColor="#888888"
            android:textSize="14sp" />

        <!-- Số lượng món -->
        <TextView
            android:id="@+id/txtSoMon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Số món: 2"
            android:textColor="#888888"
            android:textSize="14sp" />

        <!-- Đường phân cách -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="#EEEEEE" />

        <!-- Các nút thao tác -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnChiTietHoaDon"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:src="@drawable/ic_icon_eye"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground" />

            <ImageButton
                android:id="@+id/btnSuaHoaDon"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:src="@drawable/ic_icon_pen"
                android:background="?attr/selectableItemBackground"
                app:tint="#FF7854"/>
            <ImageButton
                android:id="@+id/btnXoaHoaDon"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:src="@drawable/ic_icon_delete"
                android:background="?attr/selectableItemBackground"
                app:tint="#E55353"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
